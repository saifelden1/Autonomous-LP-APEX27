<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="apex_sim_rover">

  <!-- ==================== Root Kinematic Frame ==================== -->
  <link name="base_link"/>

  <!-- ==================== Chassis ==================== -->
  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry><box size="0.6 0.4 0.15"/></geometry>
      <material name="dark"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.6 0.4 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.22" ixy="0" ixz="0" iyy="0.47" iyz="0" izz="0.65"/>
    </inertial>
  </link>

  <!-- ==================== Wheels ==================== -->
  <xacro:macro name="wheel" params="name x_pos y_pos">
    <joint name="${name}_joint" type="continuous">
      <parent link="chassis"/>
      <child link="${name}_link"/>
      <origin xyz="${x_pos} ${y_pos} -0.02" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry><cylinder radius="0.1" length="0.06"/></geometry>
        <material name="orange"><color rgba="1.0 0.4 0.0 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.1" length="0.06"/></geometry>
      </collision>
      <inertial>
        <mass value="1.5"/>
        <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0075"/>
      </inertial>
    </link>

    <gazebo reference="${name}_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel" x_pos="0.2" y_pos="0.23"/>
  <xacro:wheel name="front_right_wheel" x_pos="0.2" y_pos="-0.23"/>
  <xacro:wheel name="rear_left_wheel" x_pos="-0.2" y_pos="0.23"/>
  <xacro:wheel name="rear_right_wheel" x_pos="-0.2" y_pos="-0.23"/>

  <!-- ==================== LiDAR ==================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.9 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== Front Camera ==================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.30 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.12 0.03"/></geometry>
      <material name="silver"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.04 0.12 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== Gazebo Plugins ==================== -->
  <!-- 1. Differential Drive Motor Controller -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.46</wheel_separation>
      <wheel_diameter>0.20</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 2. LiDAR Ray Sensor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
        </range>
      </ray>
      <plugin name="gazebo_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 3. Front Camera Sensor -->
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=camera/image_raw</remapping>
          <remapping>~/camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
