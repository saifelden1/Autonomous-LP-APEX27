<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="apex_chassis">

  <!-- ==================== Materials ==================== -->
  <material name="apex_dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="apex_orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <material name="apex_blue">
    <color rgba="0.1 0.3 0.9 1.0"/>
  </material>

  <material name="apex_silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <!-- ==================== Dimensions & Constants ==================== -->
  <xacro:property name="chassis_length" value="0.6"/>
  <xacro:property name="chassis_width" value="0.4"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="chassis_mass" value="15.0"/>

  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_mass" value="1.5"/>

  <xacro:property name="wheelbase" value="0.4"/>
  <xacro:property name="track_width" value="0.46"/>

  <!-- ==================== Root Kinematic Frame ==================== -->
  <link name="base_link"/>

  <!-- ==================== Physical Chassis ==================== -->
  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="apex_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.22" ixy="0" ixz="0" iyy="0.47" iyz="0" izz="0.65"/>
    </inertial>
  </link>

  <!-- ==================== Wheel Macro ==================== -->
  <xacro:macro name="wheel" params="name x_pos y_pos">
    <joint name="${name}_joint" type="continuous">
      <parent link="chassis"/>
      <child link="${name}_link"/>
      <origin xyz="${x_pos} ${y_pos} -0.02" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="apex_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0075"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Instantiate 4 Wheels -->
  <xacro:wheel name="front_left_wheel" x_pos="${wheelbase/2}" y_pos="${track_width/2}"/>
  <xacro:wheel name="front_right_wheel" x_pos="${wheelbase/2}" y_pos="-${track_width/2}"/>
  <xacro:wheel name="rear_left_wheel" x_pos="-${wheelbase/2}" y_pos="${track_width/2}"/>
  <xacro:wheel name="rear_right_wheel" x_pos="-${wheelbase/2}" y_pos="-${track_width/2}"/>

  <!-- ==================== LiDAR Sensor Link ==================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="apex_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== Front Camera Link ==================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2} 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.12 0.03"/>
      </geometry>
      <material name="apex_silver"/>
    </visual>
  </link>

  <!-- Optical frame for ROS image algorithms (REP-105 standard: Z forward) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="camera_optical_frame"/>

</robot>
